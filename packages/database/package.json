{
  "name": "@dentasmart/database",
  "version": "0.1.0",
  "private": true,
  "main": "./src/generated/prisma/index.js",
  "types": "./src/generated/prisma/index.d.ts",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push && prisma db execute --file prisma/sql/appointment-overlap.sql --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:constraints": "prisma db execute --file prisma/sql/appointment-overlap.sql --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2"
  },
  "devDependencies": {
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "bcryptjs": "^3.0.2",
    "@types/bcryptjs": "^2.4.6"
  }
}
