model CashShift {
  id             String          @id @default(cuid())
  organizationId String
  branchId       String
  openedById     String?
  closedById     String?
  status         CashShiftStatus @default(OPEN)
  openingCash    Decimal         @default(0) @db.Decimal(12, 2)
  closingCash    Decimal?        @db.Decimal(12, 2)
  cardTotal      Decimal         @default(0) @db.Decimal(12, 2)
  cashTotal      Decimal         @default(0) @db.Decimal(12, 2)
  openedAt       DateTime        @default(now())
  closedAt       DateTime?
  notes          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("cash_shifts")
}

// ─── Напоминания (внутренние, без внешних SMS-шлюзов) ───────────────────────

enum ReminderChannel {
  SMS
  EMAIL
  TELEGRAM
  WHATSAPP
}

enum ReminderStatus {
  PENDING
  SENT
  CANCELLED
}

model Reminder {
  id             String          @id @default(cuid())
  organizationId String
  patientId      String
  appointmentId  String?
  channel        ReminderChannel @default(SMS)
  message        String
  scheduledAt    DateTime
  sentAt         DateTime?
  status         ReminderStatus  @default(PENDING)
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([organizationId, scheduledAt, status])
  @@map("reminders")
}

// ─── Инвентаризация склада ───────────────────────────────────────────────────

enum InventorySessionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model InventorySession {
  id             String                 @id @default(cuid())
  organizationId String
  branchId       String
  status         InventorySessionStatus @default(IN_PROGRESS)
  startedAt      DateTime               @default(now())
  completedAt    DateTime?
  notes          String?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines        InventoryCountLine[]

  @@map("inventory_sessions")
}

model InventoryCountLine {
  id          String  @id @default(cuid())
  sessionId   String
  itemId      String
  expectedQty Decimal @db.Decimal(12, 3)
  actualQty   Decimal @db.Decimal(12, 3)
  diffQty     Decimal @db.Decimal(12, 3)

  session InventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  item    InventoryItem    @relation(fields: [itemId], references: [id])

  @@unique([sessionId, itemId])
  @@map("inventory_count_lines")
}

// ─── Auth: refresh tokens ────────────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ─── Семейный счёт ───────────────────────────────────────────────────────────

model FamilyGroup {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      FamilyMember[]

  @@map("family_groups")
}

model FamilyMember {
  familyGroupId String
  patientId     String
  role          String   @default("MEMBER")
  joinedAt      DateTime @default(now())

  familyGroup FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@id([familyGroupId, patientId])
  @@map("family_members")
}

// ─── Депозиты и рассрочки ────────────────────────────────────────────────────

model PatientDeposit {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String   @unique
  balance        Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_deposits")
}

enum InstallmentStatus {
  ACTIVE
  COMPLETED
  DEFAULTED
  CANCELLED
}

enum InstallmentLineStatus {
  PENDING
  PAID
  OVERDUE
}

model InstallmentPlan {
  id             String            @id @default(cuid())
  organizationId String
  patientId      String
  invoiceId      String?
  totalAmount    Decimal           @db.Decimal(12, 2)
  paidAmount     Decimal           @default(0) @db.Decimal(12, 2)
  months         Int
  status         InstallmentStatus @default(ACTIVE)
  createdAt      DateTime          @default(now())

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient               @relation(fields: [patientId], references: [id])
  invoice      Invoice?              @relation(fields: [invoiceId], references: [id])
  schedule     InstallmentSchedule[]

  @@map("installment_plans")
}

model InstallmentSchedule {
  id      String                @id @default(cuid())
  planId  String
  dueDate DateTime
  amount  Decimal               @db.Decimal(12, 2)
  status  InstallmentLineStatus @default(PENDING)
  paidAt  DateTime?

  plan InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("installment_schedule")
}

// ─── Нормы расхода материалов ────────────────────────────────────────────────

model ServiceMaterialNorm {
  id             String  @id @default(cuid())
  organizationId String
  serviceId      String
  itemId         String
  quantity       Decimal @db.Decimal(12, 3)
  basis          String  @default("FIXED")
  billable       Boolean @default(false)
  sellPrice      Decimal @default(0) @db.Decimal(12, 2)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([serviceId, itemId])
  @@map("service_material_norms")
}

// Факт расхода: план держит норму, визит — то, что врач подтвердил и списал.
model MaterialUse {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String
  itemId         String
  serviceId      String?
  planItemId     String?
  appointmentId  String?
  name           String
  unit           String
  plannedQty     Decimal  @db.Decimal(12, 3)
  actualQty      Decimal  @db.Decimal(12, 3)
  unitCost       Decimal  @default(0) @db.Decimal(12, 2)
  billable       Boolean  @default(false)
  sellPrice      Decimal  @default(0) @db.Decimal(12, 2)
  suggestion     String?
  writtenOff     Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  item         InventoryItem      @relation(fields: [itemId], references: [id])
  service      Service?           @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  planItem     TreatmentPlanItem? @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  appointment  Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([patientId])
  @@index([appointmentId])
  @@index([planItemId])
  @@map("material_uses")
}

// ─── Шаблоны напоминаний ─────────────────────────────────────────────────────

model ReminderTemplate {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  channel        ReminderChannel
  body           String
  isActive       Boolean         @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("reminder_templates")
}

// ─── Конструктор зарплаты ─────────────────────────────────────────────────────

enum PayrollRuleType {
  FIXED
  PERCENT_REVENUE
  PER_SERVICE
}

model PayrollRule {
  id             String          @id @default(cuid())
  organizationId String
  employeeId     String?
  name           String
  ruleType       PayrollRuleType
  paramsJson     Json
  isActive       Boolean         @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@map("payroll_rules")
}

model Insurer {
  id             String @id @default(cuid())
  organizationId String
  name           String

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  policies     InsurancePolicy[]
  bills        InsurerBill[]

  @@unique([organizationId, name])
  @@map("insurers")
}

model InsurancePolicy {
  id             String    @id @default(cuid())
  organizationId String
  patientId      String
  insurerId      String
  number         String
  letterNumber   String?
  validTo        DateTime?
  limitAmount    Decimal   @db.Decimal(12, 2)
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  insurer      Insurer      @relation(fields: [insurerId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("insurance_policies")
}

model InsurerBill {
  id             String   @id @default(cuid())
  organizationId String
  insurerId      String
  patientName    String
  number         String
  amount         Decimal  @db.Decimal(12, 2)
  status         String   @default("DRAFT")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  insurer      Insurer      @relation(fields: [insurerId], references: [id], onDelete: Cascade)

  @@map("insurer_bills")
}

model Lead {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  phone          String
  source         String    @default("Звонок")
  status         String    @default("NEW")
  refusalReason  String?
  patientId      String?
  callbackAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)
  calls        CallRecord[]

  @@index([organizationId, status])
  @@map("leads")
}

model WarrantyCase {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String
  title          String
  toothNum       Int?
  status         String   @default("OPEN")
  reason         String
  doctorName     String?
  cost           Decimal  @default(0) @db.Decimal(12, 2)
  openedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("warranty_cases")
}

model PaymentAllocation {
  id            String  @id @default(cuid())
  paymentId     String
  invoiceItemId String
  amount        Decimal @db.Decimal(12, 2)

  payment     Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceItem InvoiceItem @relation(fields: [invoiceItemId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_allocations")
}

model ApiKey {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  token          String   @unique
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model OrthoChart {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String   @unique
  classAngle     String?
  notes          String   @default("")
  monthlyFee     Decimal? @db.Decimal(12, 2)
  contractSigned Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("ortho_charts")
}

enum SterilizationResult {
  PASS
  FAIL
}

model SterilizationCycle {
  id             String              @id @default(cuid())
  organizationId String
  branchId       String
  startedAt      DateTime            @default(now())
  autoclave      String
  loadNote       String
  result         SterilizationResult
  operatorName   String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([organizationId, startedAt])
  @@map("sterilization_cycles")
}

model PlanTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  note           String?
  phasesJson     Json
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("plan_templates")
}

model VisitTemplate {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  icd10           String?
  complaints      String   @default("")
  diagnosis       String   @default("")
  treatment       String   @default("")
  recommendations String   @default("")
  isArchived      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("visit_templates")
}

model DocumentTemplate {
  id             String   @id @default(cuid())
  organizationId String
  kind           String
  name           String
  body           String
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("document_templates")
}

model ReminderRule {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  trigger        String
  channel        ReminderChannel @default(WHATSAPP)
  body           String
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("reminder_rules")
}

model PlanVersion {
  id             String   @id @default(cuid())
  organizationId String
  planId         String
  note           String?
  snapshot       Json
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, createdAt])
  @@map("plan_versions")
}
