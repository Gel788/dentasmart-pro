generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Организация (сеть клиник) ───────────────────────────────────────────────

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  inn         String?
  phone       String?
  email       String?
  legalName   String?
  address     String?
  logoUrl     String?
  brandColor  String?  @default("#0f766e")
  ogrn        String?
  kpp         String?
  bankName    String?
  bankAccount String?
  bik         String?
  workHours   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branches             Branch[]
  users                User[]
  roles                Role[]
  patients             Patient[]
  services             Service[]
  appointments         Appointment[]
  auditLogs            AuditLog[]
  employeeSchedules    EmployeeSchedule[]
  treatmentPlans       TreatmentPlan[]
  patientConsents      PatientConsent[]
  patientSegments      PatientSegment[]
  waitlistEntries      WaitlistEntry[]
  priceLists           PriceList[]
  invoices             Invoice[]
  payments             Payment[]
  promoCodes           PromoCode[]
  loyaltyPrograms      LoyaltyProgram[]
  inventoryItems       InventoryItem[]
  stockMovements       StockMovement[]
  purchaseOrders       PurchaseOrder[]
  labOrders            LabOrder[]
  marketingCampaigns   MarketingCampaign[]
  automationChains     AutomationChain[]
  communicationThreads CommunicationThread[]
  callRecords          CallRecord[]
  integrationConfigs   IntegrationConfig[]
  integrationLogs      IntegrationLog[]
  webhookEndpoints     WebhookEndpoint[]
  widgetConfigs        WidgetConfig[]
  medicalRecordHashes  MedicalRecordHash[]
  aiInsights           AiInsight[]
  receptionQueue       ReceptionQueueItem[]
  cashShifts           CashShift[]
  reminders            Reminder[]
  inventorySessions    InventorySession[]
  familyGroups         FamilyGroup[]
  patientDeposits      PatientDeposit[]
  installmentPlans     InstallmentPlan[]
  serviceMaterialNorms ServiceMaterialNorm[]
  materialUses         MaterialUse[]
  reminderTemplates    ReminderTemplate[]
  payrollRules         PayrollRule[]
  insurers             Insurer[]
  insurancePolicies    InsurancePolicy[]
  insurerBills         InsurerBill[]
  leads                Lead[]
  warrantyCases        WarrantyCase[]
  apiKeys              ApiKey[]
  orthoCharts          OrthoChart[]
  sterilizationCycles  SterilizationCycle[]
  cabinetBlocks        CabinetBlock[]
  appointmentsToMake   AppointmentToMake[]
  perioExams           PerioExam[]
  omsPolicies          OmsPolicy[]
  omsCases             OmsCase[]
  prescriptions        Prescription[]
  followUps            FollowUp[]
  photoProtocols       PhotoProtocol[]
  planTemplates        PlanTemplate[]
  visitTemplates       VisitTemplate[]
  documentTemplates    DocumentTemplate[]
  reminderRules        ReminderRule[]
  planVersions         PlanVersion[]

  materialReservations MaterialReservation[]

  @@map("organizations")
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String?
  phone          String?
  timezone       String   @default("Europe/Moscow")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cabinets            Cabinet[]
  employees           EmployeeBranch[]
  appointments        Appointment[]
  sterilizationCycles SterilizationCycle[]
  cabinetBlocks       CabinetBlock[]
  appointmentsToMake  AppointmentToMake[]
  omsCases            OmsCase[]

  @@index([organizationId])
  @@map("branches")
}

enum CabinetPurpose {
  THERAPY
  SURGERY
  ORTHOPEDICS
  UNIVERSAL
  HYGIENE
  IMAGING
}

model Cabinet {
  id              String         @id @default(cuid())
  branchId        String
  name            String
  number          String?
  purpose         CabinetPurpose @default(UNIVERSAL)
  equipment       String[]       @default([])
  cleaningMinutes Int            @default(15)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  blocks       CabinetBlock[]

  @@index([branchId])
  @@map("cabinets")
}

// ─── Пользователи и RBAC ───────────────────────────────────────────────────

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SICK_LEAVE
  TERMINATED
}

model User {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  passwordHash   String
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  totpSecret     String?
  totpEnabled    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee      Employee?
  userRoles     UserRole[]
  auditLogs     AuditLog[]     @relation("AuditActor")
  refreshTokens RefreshToken[]
  paymentsTaken Payment[]      @relation("PaymentAuthor")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model Employee {
  id             String         @id @default(cuid())
  userId         String         @unique
  firstName      String
  lastName       String
  middleName     String?
  phone          String?
  birthDate      DateTime?
  specialization String?
  status         EmployeeStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  branches        EmployeeBranch[]
  appointments    Appointment[]         @relation("DoctorAppointments")
  schedules       EmployeeSchedule[]
  certificates    EmployeeCertificate[]
  treatmentPlans  TreatmentPlan[]
  labOrders       LabOrder[]
  payrollEntries  PayrollEntry[]
  payrollRules    PayrollRule[]
  omsCases        OmsCase[]
  curatedPatients Patient[]             @relation("PatientCurator")

  @@map("employees")
}

model EmployeeBranch {
  employeeId String
  branchId   String
  isPrimary  Boolean @default(false)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([employeeId, branchId])
  @@map("employee_branches")
}

model Role {
  id                 String   @id @default(cuid())
  organizationId     String
  code               String
  name               String
  description        String?
  isSystem           Boolean  @default(false)
  seeCost            Boolean  @default(false)
  maxDiscountPercent Int      @default(0)
  editClosedVisits   Boolean  @default(false)
  editPrice          Boolean  @default(false)
  seeAllFinance      Boolean  @default(false)
  canExport          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, code])
  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique
  module      String
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ─── Пациенты ──────────────────────────────────────────────────────────────

enum PatientGender {
  MALE
  FEMALE
  OTHER
}

enum AnxietyLevel {
  NONE
  MILD
  HIGH
}

model Patient {
  id                String         @id @default(cuid())
  organizationId    String
  firstName         String
  lastName          String
  middleName        String?
  birthDate         DateTime?
  gender            PatientGender?
  phone             String?
  email             String?
  tags              String[]       @default([])
  notes             String?
  source            String?
  /// Client type carried over from the previous CRM, e.g. «отказавшиеся».
  clientType        String?
  allergies         String[]       @default([])
  chronicConditions String?
  medications       String?
  contraindications String?
  anamnesis         String?
  anxiety           AnxietyLevel   @default(NONE)
  pregnant          Boolean        @default(false)
  anticoagulant     Boolean        @default(false)
  /// Grows with every change of the medical fields; a save names the version it was made from.
  medicalVersion    Int            @default(0)
  /// When a clinician last confirmed the medical history with the patient, and who.
  medicalConfirmedAt   DateTime?
  medicalConfirmedById String?
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments       Appointment[]
  toothRecords       ToothRecord[]
  treatmentPlans     TreatmentPlan[]
  consents           PatientConsent[]
  imagingStudies     ImagingStudy[]
  communications     PatientCommunication[]
  loyaltyAccounts    LoyaltyAccount[]
  invoices           Invoice[]
  waitlistEntries    WaitlistEntry[]
  receptionQueue     ReceptionQueueItem[]
  segmentMembers     PatientSegmentMember[]
  familyMembers      FamilyMember[]
  deposit            PatientDeposit?
  installmentPlans   InstallmentPlan[]
  labOrders          LabOrder[]
  insurancePolicies  InsurancePolicy[]
  appointmentsToMake AppointmentToMake[]
  perioExams         PerioExam[]
  omsPolicies        OmsPolicy[]
  omsCases           OmsCase[]
  toothSurfaces      ToothSurface[]
  toothEvents        ToothEvent[]
  prescriptions      Prescription[]
  followUps          FollowUp[]
  photoProtocols     PhotoProtocol[]
  materialUses       MaterialUse[]
  curatorId          String?
  curator            Employee?              @relation("PatientCurator", fields: [curatorId], references: [id], onDelete: SetNull)
  leads              Lead[]
  warrantyCases      WarrantyCase[]
  orthoChart         OrthoChart?

  routeToken          String?   @unique
  routeTokenExpiresAt DateTime?

  @@index([organizationId])
  @@index([organizationId, phone])
  @@index([organizationId, lastName, firstName])
  @@map("patients")
}

enum ToothFormulaType {
  ADULT
  CHILD
}

enum ToothCondition {
  HEALTHY
  CARIES
  FILLED
  CROWN
  MISSING
  IMPLANT
  ROOT_CANAL
  TO_EXTRACT
  OTHER
}

// EXISTING — уже во рту (пломба, коронка). PATHOLOGY — находка осмотра (кариес).
enum ChartLayer {
  EXISTING
  PATHOLOGY
}

model ToothRecord {
  id        String           @id @default(cuid())
  patientId String
  toothNum  Int
  formula   ToothFormulaType @default(ADULT)
  condition ToothCondition   @default(HEALTHY)
  layer     ChartLayer       @default(PATHOLOGY)
  surfaces  String[]         @default([])
  diagnosis String?
  notes     String?
  updatedAt DateTime         @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, formula, toothNum])
  @@map("tooth_records")
}

// Состояние одной поверхности или всего зуба (surface = TOOTH).
model ToothSurface {
  id        String           @id @default(cuid())
  patientId String
  toothNum  Int
  formula   ToothFormulaType @default(ADULT)
  surface   String
  condition ToothCondition   @default(HEALTHY)
  layer     ChartLayer       @default(PATHOLOGY)
  diagnosis String?
  updatedAt DateTime         @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, formula, toothNum, surface])
  @@index([patientId])
  @@map("tooth_surfaces")
}

model ToothEvent {
  id        String           @id @default(cuid())
  patientId String
  toothNum  Int
  formula   ToothFormulaType @default(ADULT)
  surfaces  String[]         @default([])
  condition ToothCondition
  layer     ChartLayer
  note      String?
  source    String           @default("EXAM")
  createdAt DateTime         @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, toothNum, createdAt])
  @@map("tooth_events")
}

// Пародонтальная карта: отдельный осмотр, формулу кариеса не меняет.
model PerioExam {
  id             String   @id @default(cuid())
  organizationId String
  patientId      String
  examinedAt     DateTime @default(now())
  notes          String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  teeth        PerioTooth[]

  @@index([patientId, examinedAt])
  @@map("perio_exams")
}

model PerioTooth {
  id        String  @id @default(cuid())
  examId    String
  toothNum  Int
  missing   Boolean @default(false)
  mobility  Int     @default(0)
  furcation Int     @default(0)

  exam  PerioExam   @relation(fields: [examId], references: [id], onDelete: Cascade)
  sites PerioSite[]

  @@unique([examId, toothNum])
  @@map("perio_teeth")
}

model PerioSite {
  id        String  @id @default(cuid())
  toothId   String
  position  Int
  pocket    Int     @default(0)
  recession Int     @default(0)
  bleeding  Boolean @default(false)

  tooth PerioTooth @relation(fields: [toothId], references: [id], onDelete: Cascade)

  @@unique([toothId, position])
  @@map("perio_sites")
}

enum OmsCaseStatus {
  OPEN
  CLOSED
}

model OmsPolicy {
  id             String    @id @default(cuid())
  organizationId String
  patientId      String
  number         String
  smoName        String
  region         String?
  validFrom      DateTime?
  validTo        DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  cases        OmsCase[]

  @@index([patientId])
  @@map("oms_policies")
}

model OmsCase {
  id             String        @id @default(cuid())
  organizationId String
  branchId       String
  patientId      String
  policyId       String
  doctorId       String?
  openedAt       DateTime      @default(now())
  closedAt       DateTime?
  icd10          String?
  result         String?
  status         OmsCaseStatus @default(OPEN)
  exportStatus   String        @default("NOT_SENT")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  policy       OmsPolicy     @relation(fields: [policyId], references: [id], onDelete: Cascade)
  doctor       Employee?     @relation(fields: [doctorId], references: [id])
  lines        OmsCaseLine[]

  @@index([patientId, status])
  @@map("oms_cases")
}

model OmsCaseLine {
  id       String  @id @default(cuid())
  caseId   String
  code     String
  title    String
  toothNum Int?
  quantity Int     @default(1)
  tariff   Decimal @default(0) @db.Decimal(12, 2)

  case OmsCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("oms_case_lines")
}

// ─── Справочник услуг ──────────────────────────────────────────────────────

model Service {
  id             String   @id @default(cuid())
  organizationId String
  parentId       String?
  code           String?
  name           String
  description    String?
  durationMin    Int      @default(30)
  basePrice      Decimal  @default(0) @db.Decimal(12, 2)
  icd10Code      String?
  requiresTooth  Boolean  @default(false)
  surfaceMode    String   @default("NONE")
  doctorPercent  Decimal  @default(0) @db.Decimal(5, 2)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent             Service?              @relation("ServiceTree", fields: [parentId], references: [id])
  children           Service[]             @relation("ServiceTree")
  appointments       Appointment[]
  treatmentPlanItems TreatmentPlanItem[]
  priceListItems     PriceListItem[]
  materialNorms      ServiceMaterialNorm[]
  materialUses       MaterialUse[]
  appointmentsToMake AppointmentToMake[]

  @@index([organizationId])
  @@map("services")
}

// ─── Расписание ────────────────────────────────────────────────────────────

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id             String            @id @default(cuid())
  organizationId String
  branchId       String
  cabinetId      String?
  doctorId       String?
  patientId      String
  serviceId      String?
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(SCHEDULED)
  notes          String?
  noShowReason   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch              @relation(fields: [branchId], references: [id])
  cabinet        Cabinet?            @relation(fields: [cabinetId], references: [id])
  doctor         Employee?           @relation("DoctorAppointments", fields: [doctorId], references: [id])
  patient        Patient             @relation(fields: [patientId], references: [id])
  service        Service?            @relation(fields: [serviceId], references: [id])
  reminders      Reminder[]
  treatmentPlans TreatmentPlan[]
  planItems      TreatmentPlanItem[]
  invoices       Invoice[]
  visitNote      VisitNote?
  imagingStudies ImagingStudy[]
  prescriptions  Prescription[]
  followUps      FollowUp[]          @relation("FollowSource")
  photoProtocols PhotoProtocol[]
  materialUses   MaterialUse[]

  reservations MaterialReservation[]

  @@index([organizationId, startsAt])
  @@index([branchId, startsAt])
  @@index([doctorId, startsAt])
  @@index([patientId])
  @@map("appointments")
}

// ─── Аудит ─────────────────────────────────────────────────────────────────

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  LOGIN
  LOGOUT
}

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  userId         String?
  entityType     String
  entityId       String?
  action         AuditAction
  changes        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime    @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation("AuditActor", fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─── Сотрудники: график и сертификаты ───────────────────────────────────────

model EmployeeSchedule {
  id             String  @id @default(cuid())
  organizationId String
  employeeId     String
  branchId       String
  dayOfWeek      Int
  startsAt       String
  endsAt         String
  breakStart     String?
  breakEnd       String?
  isActive       Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_schedules")
}

model EmployeeCertificate {
  id         String    @id @default(cuid())
  employeeId String
  title      String
  issuedAt   DateTime?
  expiresAt  DateTime?
  fileUrl    String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_certificates")
}

// ─── Клиника: планы лечения, дневник, снимки ───────────────────────────────

enum TreatmentPlanStatus {
  DRAFT
  PROPOSED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum PlanTier {
  ECONOM
  OPTIMUM
  PREMIUM
}

model TreatmentPlan {
  id                String              @id @default(cuid())
  organizationId    String
  patientId         String
  appointmentId     String?
  doctorId          String?
  title             String
  status            TreatmentPlanStatus @default(DRAFT)
  totalPrice        Decimal             @default(0) @db.Decimal(12, 2)
  discountPercent   Decimal             @default(0) @db.Decimal(5, 2)
  notes             String?
  isAlternative     Boolean             @default(false)
  parentPlanId      String?
  acceptedAt        DateTime?
  presentedAt       DateTime?
  validUntil        DateTime?
  tier              PlanTier?
  familyKey         String?
  guaranteeMonths   Int                 @default(12)
  durationWeeks     Int                 @default(4)
  signatureSvg      String?             @db.Text
  signedName        String?
  signedAt          DateTime?
  installmentMonths Int                 @default(0)
  /// Whether the patient's copy shows what each price is made of.
  showBreakdown     Boolean             @default(true)
  abandonedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patient      Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment  Appointment?          @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  doctor       Employee?             @relation(fields: [doctorId], references: [id])
  parentPlan   TreatmentPlan?        @relation("PlanAlternatives", fields: [parentPlanId], references: [id])
  alternatives TreatmentPlan[]       @relation("PlanAlternatives")
  phases       PlanPhase[]
  items        TreatmentPlanItem[]
  diaryEntries TreatmentDiaryEntry[]
  invoices     Invoice[]
  versions     PlanVersion[]

  @@index([patientId])
  @@index([appointmentId])
  @@index([familyKey])
  @@map("treatment_plans")
}

// Этап плана. Следующий этап может начаться только после заживления предыдущего.
model PlanPhase {
  id          String  @id @default(cuid())
  planId      String
  title       String
  sortOrder   Int     @default(0)
  specialty   String?
  healingDays Int     @default(0)
  dependsOnId String?

  plan           TreatmentPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  dependsOn      PlanPhase?          @relation("PhaseDepends", fields: [dependsOnId], references: [id], onDelete: SetNull)
  blocked        PlanPhase[]         @relation("PhaseDepends")
  labWork        String?
  items          TreatmentPlanItem[]
  imagingStudies ImagingStudy[]
  photoProtocols PhotoProtocol[]

  labOrders LabOrder[]

  @@index([planId])
  @@map("plan_phases")
}

enum PlanItemStatus {
  PROPOSED
  ACCEPTED
  DONE
  REJECTED
}

model TreatmentPlanItem {
  id              String         @id @default(cuid())
  planId          String
  serviceId       String?
  toothNum        Int?
  surfaces        String[]       @default([])
  phase           Int            @default(1)
  title           String
  sortOrder       Int            @default(0)
  price           Decimal        @default(0) @db.Decimal(12, 2)
  listPrice       Decimal?       @db.Decimal(12, 2)
  discountPercent Decimal        @default(0) @db.Decimal(5, 2)
  durationMin     Int            @default(30)
  isCompleted     Boolean        @default(false)
  status          PlanItemStatus @default(PROPOSED)
  appointmentId   String?
  completedAt     DateTime?
  phaseId         String?

  plan         TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  service      Service?      @relation(fields: [serviceId], references: [id])
  invoiceItem  InvoiceItem?
  appointment  Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  phaseRef     PlanPhase?    @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  materialUses MaterialUse[]

  reservations MaterialReservation[]

  @@map("treatment_plan_items")
}

model TreatmentDiaryEntry {
  id        String   @id @default(cuid())
  planId    String
  toothNum  Int?
  notes     String
  photoUrl  String?
  createdAt DateTime @default(now())

  plan TreatmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("treatment_diary_entries")
}

enum ImagingType {
  OPG
  CT
  INTRAORAL
  STL
  PLY
